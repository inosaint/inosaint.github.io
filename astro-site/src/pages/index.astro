---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import PostHog from '../components/posthog.astro';

// This page is its own document rather than a BaseLayout child: it owns the
// whole viewport, has no container or site chrome, and paints its own footer.
// So the head BaseLayout would have given it is assembled here instead — same
// canonical, card and schema contract, or the home page would lose the SEO the
// rest of the site has.
const siteUrl = 'https://kenneth.dsouza.im';
const canonicalUrl = `${siteUrl}/`;
const pageTitle = 'Kenneth Mark Dsouza — Product Design Manager';
const pageDescription =
  'I design digital products, explore emerging tech and build things that live on the internet. Product Design Manager with experience building and leading design teams in India and Indonesia.';
const cardImage = new URL('/images/profile.png', siteUrl).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${siteUrl}/#person`,
      name: 'Kenneth Mark Dsouza',
      url: `${siteUrl}/`,
      image: cardImage,
      jobTitle: 'Product Design Manager',
      description:
        'Product Design Manager with experience building and leading design teams in India and Indonesia.',
      sameAs: ['https://x.com/kenneth', 'https://bsky.app/profile/ken.cv', 'https://github.com/inosaint'],
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: `${siteUrl}/`,
      name: 'Kenneth Mark Dsouza',
      description: pageDescription,
      publisher: { '@id': `${siteUrl}/#person` },
      inLanguage: 'en',
    },
    {
      '@type': 'WebPage',
      '@id': canonicalUrl,
      url: canonicalUrl,
      name: pageTitle,
      description: pageDescription,
      isPartOf: { '@id': `${siteUrl}/#website` },
      about: { '@id': `${siteUrl}/#person` },
    },
  ],
};

// --- Sheet 1: Work -------------------------------------------------------
const work = (await getCollection('work', ({ data }) => data.status === 'published'))
  .sort((a, b) => parseInt(b.data.year.split('-')[0]) - parseInt(a.data.year.split('-')[0]))
  .slice(0, 3)
  .map((item) => ({
    title: item.data.title,
    meta: item.data.year,
    url: `/work/${item.id}`,
    image: item.data.image ?? null,
    imageUrl: null as string | null,
    external: false,
  }));

// --- Sheet 2: Writing ----------------------------------------------------
// A short external list mirrors the homepage; the study only needs the newest few.
const externalWritings = [
  {
    title: 'Squads as a Growth Engine for Designers',
    url: 'https://medium.com/notes-from-the-fields/how-we-used-squads-to-help-our-designers-level-up-443fcbc52e2f',
    imageUrl: 'https://miro.medium.com/v2/resize:fit:1400/format:webp/1*iuV8e1TmjIe0zsr8yQfXyA.jpeg',
    date: new Date('2025-08-18'),
  },
  {
    title: 'Redesigning the Sahabat Jiva app',
    url: 'https://medium.com/notes-from-the-fields/from-field-insights-to-better-ux-for-our-sahabat-jivas-3056b32ba51f',
    imageUrl: 'https://miro.medium.com/v2/resize:fit:1400/format:webp/1*3Fnwkn7IeOiYbTxz-n3K7w.jpeg',
    date: new Date('2025-05-15'),
  },
  {
    title: 'How a sticker design became an unofficial Mascot',
    url: 'https://medium.com/notes-from-the-fields/more-than-swag-how-a-last-minute-sticker-became-a-company-icon-42d86246e736',
    imageUrl: 'https://miro.medium.com/v2/resize:fit:1400/format:webp/1*Nq0RLdn32pPVk-zLPFy-Cw.png',
    date: new Date('2024-11-28'),
  },
];

const writing = [
  ...(await getCollection('writing', ({ data }) => data.status === 'published')).map((post) => ({
    title: post.data.title,
    date: new Date(post.data.date),
    url: post.data.url ?? `/writing/${post.id}/`,
    image: post.data.image ?? null,
    imageUrl: null as string | null,
    external: Boolean(post.data.url),
  })),
  ...externalWritings.map((post) => ({ ...post, image: null, external: true })),
]
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  .slice(0, 3)
  .map((post) => ({
    title: post.title,
    // Day-month-year: a letter is dated, not just filed under a month.
    meta: post.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }),
    url: post.url,
    image: post.image,
    imageUrl: post.imageUrl,
    external: post.external,
  }));

// --- Sheet 3: Projects ---------------------------------------------------
// Pulled at build time from the AI playground, which is the canonical list and
// lives outside this repo. Its tiles are newest-first and carry everything the
// sheet needs on the anchor itself, so a regex over the markup is enough — no
// parser, and no feed to keep in sync. If the fetch fails the build must not,
// so a hand-written trio stands in.
//
// Every setting for that pull lives here. Note the page is static: `live` is
// read when the site is BUILT, so the letter shows whatever the playground held
// at deploy time and only refreshes on the next build.
const PROJECTS = {
  /** Where the tiles come from. */
  url: 'https://kenneth.dsouza.im/ai/',
  /** How many to show. The letter is sized for three. */
  count: 3,
  /** false → skip the network entirely and use the hand-written trio below. */
  live: true,
  /** false → leave art-less tiles on their category glyph instead of going to
   *  the project's own page for an og:image. One fetch per art-less tile. */
  fetchMissingArt: true,
  /** Give up on any single request after this. */
  timeoutMs: 8000,
};

const AI_PROJECTS_URL = PROJECTS.url;

// One icon set, drawn in a single thin-stroke vocabulary, used twice: once at
// the head of each letter, and again as the stand-in when an entry has no
// artwork. Each viewBox is cropped to the drawing's stroke-inclusive bounds
// (with half a unit of slack), so the box's foot IS the glyph's foot — which is
// what lets the heading icons sit on the type's baseline. --vw/--vh carry those
// units so a single scale sizes every icon without distorting any of them.
//
// The three letter ids come first; the rest are the categories the AI page tags
// its tiles with, so a project falls back to its own kind before its letter's.
const ICONS: Record<string, { box: string; vw: number; vh: number; d: string[] }> = {
  work: { box: '1.5 3 21 17.5', vw: 21, vh: 17.5, d: ['M3 7.5h18v12H3z', 'M8.5 7.5v-2a1 1 0 0 1 1-1h5a1 1 0 0 1 1 1v2'] },
  writing: { box: '2.5 2.5 19 18.5', vw: 19, vh: 18.5, d: ['M4 20l4.5-1.2L20 7.3l-3.3-3.3L5.2 15.5z', 'M15.6 5.1l3.3 3.3'] },
  projects: { box: '1.5 1.5 21 20.5', vw: 21, vh: 20.5, d: ['M12 3l2.2 6.8L21 12l-6.8 2.2L12 21l-2.2-6.8L3 12l6.8-2.2z'] },
  event: { box: '3 3 18 18', vw: 18, vh: 18, d: ['M3.5 6h17v14h-17z', 'M3.5 11h17', 'M8 3.5v5', 'M16 3.5v5'] },
  app: { box: '4 4 16 16', vw: 16, vh: 16, d: ['M4.5 4.5h6v6h-6z', 'M13.5 4.5h6v6h-6z', 'M4.5 13.5h6v6h-6z', 'M13.5 13.5h6v6h-6z'] },
  exploration: { box: '2.5 2.5 19 19', vw: 19, vh: 19, d: ['M12 3.5a8.5 8.5 0 1 0 0 17 8.5 8.5 0 0 0 0-17z', 'M15.5 8.5l-2 5-5 2 2-5z'] },
  visualization: { box: '3 8 18 13', vw: 18, vh: 13, d: ['M4 20h16', 'M7.5 20v-7', 'M12 20v-11', 'M16.5 20v-4'] },
  game: { box: '2 7 20 10', vw: 20, vh: 10, d: ['M7 8h10a4 4 0 0 1 0 8H7a4 4 0 0 1 0-8z', 'M9.5 10.5v3', 'M8 12h3', 'M15.5 11h.01', 'M17 13.5h.01'] },
};

type SheetItem = {
  title: string;
  meta: string;
  url: string;
  mono?: string;
  cat?: string;
  image: any;
  imageUrl: string | null;
  external: boolean;
};

const projectsFallback: SheetItem[] = [
  { title: 'AI Projects', meta: 'Tinkering', url: AI_PROJECTS_URL, cat: 'app', image: null, imageUrl: null, external: true },
  { title: 'Design Demo Nights', meta: 'Community', url: 'https://designdemonights.com', cat: 'event', image: null, imageUrl: null, external: true },
  { title: 'Travelogues', meta: 'Writing', url: 'https://aninosaintlife.wordpress.com/category/travels/', cat: 'exploration', image: null, imageUrl: null, external: true },
];

const decode = (str: string) =>
  str
    .replace(/&#x27;|&#39;/g, '\u2019')
    .replace(/&quot;/g, '"')
    .replace(/&#8217;/g, '\u2019')
    .replace(/&amp;/g, '&');

// Two initials, the same shape as the monograms above, for tiles with no art.
const monogram = (title: string) =>
  title
    .replace(/[^A-Za-z ]/g, '')
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((w) => w[0].toUpperCase())
    .join('') || 'AI';

async function fetchAiProjects(): Promise<SheetItem[]> {
  const res = await fetch(AI_PROJECTS_URL, { signal: AbortSignal.timeout(PROJECTS.timeoutMs) });
  if (!res.ok) throw new Error(`${res.status} from ${AI_PROJECTS_URL}`);
  const html = await res.text();

  const all: SheetItem[] = [];
  for (const tile of html.match(/<a[^>]*class="tile"[\s\S]*?<\/a>/g) ?? []) {
    const attr = (name: string) => tile.match(new RegExp(`${name}="([^"]*)"`))?.[1] ?? null;
    const href = attr('href');
    const title = tile.match(/<span class="tn">([^<]*)<\/span>/)?.[1];
    // Placeholder tiles point at '#'; they have nothing to open.
    if (!href || href === '#' || !title) continue;

    const img = attr('data-img');
    const cat = attr('data-cat') ?? '';
    all.push({
      title: decode(title),
      meta: cat ? cat[0].toUpperCase() + cat.slice(1) : 'Project',
      url: new URL(href, AI_PROJECTS_URL).href,
      cat,
      image: null,
      imageUrl: img ? new URL(img, AI_PROJECTS_URL).href : null,
      external: true,
    });
  }

  // Newest first, exactly as the page orders them.
  const chosen = all.slice(0, PROJECTS.count);

  // Not every tile carries art. Rather than pick different projects, ask the
  // ones that don't for their own og:image — a monogram beside two photographs
  // reads as a gap. Failures fall back to the monogram, so this can only add.
  await Promise.all(
    chosen.map(async (item) => {
      if (item.imageUrl || !PROJECTS.fetchMissingArt) return;
      try {
        const page = await fetch(item.url, { signal: AbortSignal.timeout(PROJECTS.timeoutMs) });
        if (!page.ok) return;
        const og = (await page.text()).match(
          /<meta[^>]*property="og:image"[^>]*content="([^"]+)"/i
        )?.[1];
        if (og) {
          item.imageUrl = new URL(decode(og), item.url).href;
        }
      } catch {
        /* keep the monogram */
      }
    })
  );

  if (!chosen.length) throw new Error('no tiles matched');
  return chosen;
}

let projects = projectsFallback.slice(0, PROJECTS.count);
if (PROJECTS.live) {
  try {
    projects = await fetchAiProjects();
  } catch (err) {
    console.warn(`[home] AI projects fetch failed, using fallback: ${err}`);
  }
}

const sheets = [
  { id: 'work', label: 'Work', href: '/work', items: work },
  { id: 'writing', label: 'Writing', href: '/writing', items: writing },
  { id: 'projects', label: 'Projects', href: 'https://kenneth.dsouza.im/ai/', items: projects },
];

// --- Stickers: interests, lifted from the resume -------------------------
const stickers = [
  { id: 'coffee', emoji: '☕️', label: 'Filter coffee', url: 'https://www.instagram.com/filtercoffeeconnoisseur/', art: '/images/stickers/filter-coffee.svg', artW: 82, artH: 66, tip: '@filtercoffeeconnoisseur' },
  { id: 'books', emoji: '📚', label: 'Reading', url: 'https://www.goodreads.com/user/show/86283809-kenneth-dsouza', art: '/images/stickers/goodreads.svg', artW: 132, artH: 33, tip: 'What I\u2019m reading' },
  { id: 'nights', emoji: '🌙', label: 'Demo Nights', url: 'https://designdemonights.com', art: '/images/stickers/demo-nights.webp', artW: 96, artH: 106, tip: 'designdemonights.com' },
  { id: 'films', emoji: '🎞️', label: 'Letterboxd', url: 'https://letterboxd.com/papercutx/', art: '/images/stickers/letterboxd.svg', artW: 64, artH: 64, tip: 'What I\u2019m watching' },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <meta name="author" content="Kenneth Mark Dsouza" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Security headers, matching BaseLayout's. img-src allows https because
         the Projects letter shows artwork fetched from the AI playground. -->
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://fonts.cdnfonts.com; font-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com https://fonts.cdnfonts.com; img-src 'self' https: data:; script-src 'self' 'unsafe-inline' https://us-assets.i.posthog.com; connect-src 'self' https://us.i.posthog.com https://us-assets.i.posthog.com;" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <title>{pageTitle}</title>

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180x180.png" />

    <link rel="alternate" type="application/rss+xml" title="Kenneth Mark Dsouza — Writing" href="/rss.xml" />

    <PostHog />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kenneth Mark Dsouza" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={cardImage} />
    <meta property="og:image:secure_url" content={cardImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="Kenneth Mark Dsouza" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={cardImage} />
    <meta name="twitter:image:alt" content="Kenneth Mark Dsouza" />
    <meta name="twitter:creator" content="@kenneth" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Render-blocking on purpose: Slackside writes the address and Hanken
         sets the stamp's cancel, which is the whole of the first paint here. -->
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600&display=swap" rel="stylesheet" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Slackside+One&display=swap" rel="stylesheet" crossorigin="anonymous" />
    <!-- Liter is the body face, and nothing on the closed card is set in it —
         it is first needed inside the letters, which are two seconds of opening
         away. Loaded off the critical path (a print stylesheet does not block
         rendering) and switched on the moment it arrives. It also lives on a
         third origin, so the handshake gets a head start of its own. -->
    <link rel="preconnect" href="https://fonts.cdnfonts.com" crossorigin />
    <link
      href="https://fonts.cdnfonts.com/css/liter"
      rel="stylesheet"
      crossorigin="anonymous"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link href="https://fonts.cdnfonts.com/css/liter" rel="stylesheet" crossorigin="anonymous" />
    </noscript>
  </head>

  <body>
    <div class="lab-stage">
        <div class="lab-canvas" id="lab-canvas">
          <span class="lab-ground" aria-hidden="true"></span>
          <span class="lab-grain" aria-hidden="true"></span>
          <span class="env-shadow" id="env-shadow" aria-hidden="true"></span>

          <!-- Envelope ----------------------------------------------------->
          <div class="env-scene" id="env-scene">
            <button class="env" id="env" type="button" aria-describedby="env-hint">
              <span class="sr-only">Open the envelope, then drag it around</span>

              <!-- Front: the addressed face -->
              <span class="env-face env-front" aria-hidden="true">
                <span class="env-address">
                  <span class="env-name">Kenneth Mark Dsouza</span>
                  <span class="env-title">Product Design Manager</span>
                  <span class="env-blurb">I design digital products, explore emerging tech and build things that live on the internet.</span>
                </span>
                <span class="env-stamp">
                  <span class="env-stamp-paper">
                    <img src="/images/stamp-portrait.webp" alt="" width="800" height="800" class="env-photo" />
                  </span>
                  <svg class="env-cancel" viewBox="0 0 200 130">
                    <defs>
                      <path id="env-arc-top" d="M 25 65 A 40 40 0 0 1 105 65" />
                      <path id="env-arc-bottom" d="M 21 65 A 44 44 0 0 0 109 65" />
                    </defs>
                    <circle cx="65" cy="65" r="52" />
                    <text text-anchor="middle"><textPath href="#env-arc-top" startOffset="50%" text-anchor="middle" dx="0.7">HELLO FROM</textPath></text>
                    <text text-anchor="middle"><textPath href="#env-arc-bottom" startOffset="50%" text-anchor="middle" dx="0.7">BENGALURU</textPath></text>
                    <g class="env-waves">
                    <path d="M30 48 q10 -4.5 20 0 t20 0 t20 0 t20 0 t20 0" />
                    <path d="M30 60 q10 -4.5 20 0 t20 0 t20 0 t20 0 t20 0" />
                    <path d="M30 72 q10 -4.5 20 0 t20 0 t20 0 t20 0 t20 0" />
                    <path d="M30 84 q10 -4.5 20 0 t20 0 t20 0 t20 0 t20 0" />
                    </g>
                  </svg>
                </span>
              </span>

              <!-- Back: an inland letter card. Closed, the message panel is
                   folded up behind the address panel and the side tabs gummed
                   over it. Open, the whole thing lies flat — which is the point:
                   nothing has to be threaded in front of the letters. -->
              <span class="env-face env-back" aria-hidden="true">
                <span class="env-inside"></span>
                <span class="env-fold env-fold-l"><i></i></span>
                <span class="env-fold env-fold-r"><i></i></span>
                <span class="env-fold env-fold-t"><i></i></span>
                <span class="env-fold env-fold-b">
                  <i></i>
                  <span class="env-heart" aria-hidden="true">
                    <svg viewBox="0 0 24 26">
                      <path class="env-heart-lo" d="M12 20.7 3.8 12.5a5 5 0 0 1 7.1-7.1L12 6.5l1.1-1.1a5 5 0 1 1 7.1 7.1z" />
                      <path class="env-heart-hi" d="M12 20.7 3.8 12.5a5 5 0 0 1 7.1-7.1L12 6.5l1.1-1.1a5 5 0 1 1 7.1 7.1z" />
                      <path class="env-heart-fill" d="M12 20.7 3.8 12.5a5 5 0 0 1 7.1-7.1L12 6.5l1.1-1.1a5 5 0 1 1 7.1 7.1z" />
                    </svg>
                  </span>
                </span>
                <span class="env-seal"></span>
              </span>
            </button>
          </div>

          <!-- Letters ------------------------------------------------------>
          {sheets.map((sheet, i) => (
            <article
              class="sheet"
              data-sheet={i}
              data-tone={['cream', 'blue', 'tan'][i]}
              tabindex="0"
              aria-label={`${sheet.label} — drag, or use arrow keys to move`}
            >
              <header class="sheet-head">
                <span class="sheet-icon" aria-hidden="true">
                  <svg viewBox={ICONS[sheet.id].box} style={`--vw:${ICONS[sheet.id].vw};--vh:${ICONS[sheet.id].vh}`}>
                    {ICONS[sheet.id].d.map((d) => <path d={d} />)}
                  </svg>
                </span>
                <h2>{sheet.label}</h2>
              </header>

              <ul class="sheet-items">
                {sheet.items.map((item) => (
                  <li>
                    <a
                      href={item.url}
                      target={item.external ? '_blank' : undefined}
                      rel={item.external ? 'noopener noreferrer' : undefined}
                    >
                      {item.image ? (
                        <Image src={item.image} alt="" class="sheet-thumb" width={120} height={90} densities={[2]} />
                      ) : item.imageUrl ? (
                        <img src={item.imageUrl} alt="" class="sheet-thumb" width="120" height="90" loading="lazy" />
                      ) : (
                        <span class="sheet-thumb sheet-glyph">
                          {(() => {
                            // A project knows its own kind; anything else wears
                            // the mark of the letter it arrived in.
                            const g = ICONS[(item as any).cat] ?? ICONS[sheet.id] ?? ICONS.projects;
                            return (
                              <svg viewBox={g.box} style={`--vw:${g.vw};--vh:${g.vh}`} aria-hidden="true">
                                {g.d.map((d) => <path d={d} />)}
                              </svg>
                            );
                          })()}
                        </span>
                      )}
                      <span class="sheet-text">
                        <span class="sheet-title">{item.title}</span>
                        <span class="sheet-meta">{item.meta}</span>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>

              <a href={sheet.href} class="sheet-all">all {sheet.label.toLowerCase()} →</a>
            </article>
          ))}

          <!-- Stickers ----------------------------------------------------->
          {stickers.map((sticker, i) => (
            <div
              class={sticker.art ? 'sticker sticker-art' : 'sticker'}
              data-sticker={i}
              style={sticker.art ? `--art-w:${sticker.artW}px` : undefined}
              tabindex={sticker.art ? undefined : 0}
              role={sticker.art ? undefined : 'button'}
              aria-label={sticker.art ? undefined : `${sticker.label} sticker — drag, or use arrow keys to move`}
            >
              {sticker.art ? (
                <a href={sticker.url} target="_blank" rel="noopener noreferrer" draggable="false">
                  <img src={sticker.art} alt={sticker.label} width={sticker.artW} height={sticker.artH} draggable="false" />
                  <span class="sticker-tip">{sticker.tip}</span>
                </a>
              ) : (
                <>
                  <span class="sticker-emoji" aria-hidden="true">{sticker.emoji}</span>
                  <span class="sticker-label">{sticker.label}</span>
                </>
              )}
            </div>
          ))}

        </div>
      </div>

      <!-- Once the card is open its face is turned away, so the two things it
           was carrying — whose page this is, and what he does — have nowhere
           left to live. The bar restates the first and puts the second behind
           About. Held back until the card opens: before that the envelope says
           both, and a header would only talk over it. -->
      <header class="lab-topbar" id="lab-topbar">
        <!-- Home, which from home is a reload: the way back to the closed
             envelope once the letters have been dragged around. -->
        <a class="lab-topbar-name" href="/">Kenneth Mark Dsouza</a>
