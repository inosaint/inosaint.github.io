---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import WritingCard from '../components/WritingCard.astro';
import { getWritingCards } from '../lib/writing-cards';
import { aiProjects } from '../data/ai-projects';
import { workshops } from '../data/resume';

// Get all published work and sort by year (newest first)
const allWork = await getCollection('work', ({ data }) => {
  return data.status === 'published';
});
const work = allWork.sort((a, b) => {
  // Extract the starting year from the year string (e.g., "2023-2024" -> 2023)
  const yearA = parseInt(a.data.year.split('-')[0]);
  const yearB = parseInt(b.data.year.split('-')[0]);
  return yearB - yearA;
});

// Writing about how the work got done — process, hiring, building and running
// teams. Local post slugs and external-writing ids; shown newest first.
const workWritingIds = [
  'hiring-2',
  'squads-growth-engine',
  'toko-poster',
  'gamify-designops',
  'gojek-cross-border',
  'process',
  'rituals',
  'hiring',
];
const workWriting = (await getWritingCards()).filter((writing) => workWritingIds.includes(writing.id));

// "DesignUp, VizChitra, CEC Mangalore and NID" — follows resume.ts, newest first.
const venues = workshops.map((w) => w.venue);
const workshopVenues =
  venues.length > 1 ? `${venues.slice(0, -1).join(', ')} and ${venues.at(-1)}` : venues.join('');
---

<BaseLayout title="Work - Kenneth Mark Dsouza" wide>
  <nav class="breadcrumb-header">
    <div class="breadcrumb">
      <a href="/" class="breadcrumb-link">Home</a>
      <span class="breadcrumb-separator">/</span>
      <span class="breadcrumb-current">Work</span>
    </div>
  </nav>

  <h1 class="page-title">Work</h1>

  <div class="grid">
    {work.map(item => (
      <a href={`/work/${item.id}`} class="card">
        {item.data.image ? (
          <Image
            src={item.data.image}
            alt={item.data.title}
            class="card-image"
            width={450}
            height={250}
            densities={[1.5, 2]}
          />
        ) : (
          <img
            src="https://placehold.co/450x250"
            alt={item.data.title}
            class="card-image"
            width="450"
            height="250"
          />
        )}
        <h3>{item.data.title}</h3>
        <p>{item.data.description}</p>
      </a>
    ))}
  </div>

  {workWriting.length > 0 && (
    <section class="work-section" aria-labelledby="work-writing-heading">
      <h2 id="work-writing-heading">Writing on process &amp; teams</h2>
      <div class="grid grid--compact">
        {workWriting.map((writing) => <WritingCard writing={writing} compact />)}
      </div>
    </section>
  )}

  <section class="work-section" aria-labelledby="community-heading">
    <h2 id="community-heading">Workshops &amp; community</h2>
    <div class="grid">
      <a
        href="https://designdemonights.com"
        target="_blank"
        rel="noopener noreferrer"
        class="card"
        title="Design Demo Nights (opens in new tab)"
      >
        <img
          src="https://kenneth.dsouza.im/ai/projects/design-demos/demos-7.webp"
          alt="Design Demo Nights poster: a retro computer reading 'Design Demo Nights for designers'"
          class="card-image"
          width="450"
          height="250"
          loading="lazy"
        />
        <h3>
          Design Demo Nights
          <sup class="external-link-icon" aria-hidden="true">
            [<span class="material-symbols-outlined">arrow_outward</span>]
          </sup>
          <span class="sr-only"> (opens in new tab)</span>
        </h3>
        <p>A monthly showcase in Bengaluru for designers building in public. Running since March 2026.</p>
      </a>
      <a href="/resume#workshops" class="card">
        <img
          src="/images/vizchitra-workshop-1.webp"
          alt="Group photo of workshop participants at VizChitra 2026"
          class="card-image"
          width="450"
          height="250"
          loading="lazy"
        />
        <h3>Workshops</h3>
        <p>
          {workshops.length} workshops on designing and building with AI, at {workshopVenues}.
        </p>
      </a>
    </div>
  </section>

  <section class="work-section" aria-labelledby="ai-projects-heading">
    <div class="section-header">
      <h2 id="ai-projects-heading">Selected AI projects</h2>
      <a href="https://kenneth.dsouza.im/ai/" class="view-all">View all</a>
    </div>
    <div class="grid grid--four">
      {aiProjects.map((project) => (
        <a
          href={project.url}
          target="_blank"
          rel="noopener noreferrer"
          class="card"
          title={`${project.title} (opens in new tab)`}
        >
          <img src={project.image} alt={project.title} class="card-image" width="450" height="250" loading="lazy" />
          <h3>
            {project.title}
            <sup class="external-link-icon" aria-hidden="true">
              [<span class="material-symbols-outlined">arrow_outward</span>]
            </sup>
            <span class="sr-only"> (opens in new tab)</span>
          </h3>
          <p>{project.description}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
