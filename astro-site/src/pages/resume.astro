---
import BaseLayout from '../layouts/BaseLayout.astro';

import { leadershipHighlights, selectedWritingAndSpeaking, workshops, elsewhereOnTheInternet, experience, education, certifications } from '../data/resume';
---

<BaseLayout
  title="Resume - Kenneth Mark Dsouza"
  description="Resume of Kenneth Mark Dsouza, a product design leader with experience in design leadership, team building, design systems, and product work across India and Indonesia."
  wide
>
  <nav class="breadcrumb-header">
    <div class="breadcrumb">
      <a href="/" class="breadcrumb-link">Home</a>
      <span class="breadcrumb-separator">/</span>
      <span class="breadcrumb-current">Resume</span>
    </div>
  </nav>

  <div class="resume-intro">
    <div class="resume-header">
      <h1>Resume</h1>
      <a href="/kenneths_resume.pdf" download="kenneths_resume.pdf" class="resume-download">
        <span class="material-symbols-outlined resume-download__icon">download</span>
        Download
      </a>
    </div>
    <div class="profile-container">
      <img
        src="/images/profile.png"
        alt="Kenneth Mark Dsouza"
        class="profile-photo"
      />
      <img
        src="/images/postmark.svg"
        alt=""
        class="postmark"
      />
    </div>
  </div>

  <section class="resume-section">
    <p>
      Born and brought up in the coastal city of Mangalore in a Roman Catholic household, I pursued a career as an engineer until, by a spot of luck, I came across the field of design. After a Master&apos;s degree in Information and Interface Design from the National Institute of Design, I began my practice as a digital product designer.
    </p>
    
    <p>

      My first job as a designer was at <a href="https://www.practo.com/providers" target="_blank" rel="noopener noreferrer">Practo<span class="sr-only"> (opens in new tab)</span></a>, an Indian healthcare startup, working on their doctor facing products like <a href="https://www.practo.com/practo-pro-app" target="_blank" rel="noopener noreferrer">Practo Pro<span class="sr-only"> (opens in new tab)</span></a> and <a href="http://practo.com/providers/clinics/ray"  target="_blank" rel="noopener noreferrer">Practo Ray<span class="sr-only"> (opens in new tab)</span></a>.
      then I worked at <a href="https://www.gojek.com/en-id/" target="_blank" rel="noopener noreferrer">Gojek<span class="sr-only">(opens in new tab)</span></a>, the Indonesian SuperApp, heading design for their Merchant SuperApp aka <a href="https://web.archive.org/web/20220402184509/https://gobiz.co.id/" target="_blank" rel="noopener noreferrer">GoBiz<span class="sr-only"> (opens in new tab)</span></a>.
    </p>

    <p>
      Recently, I was a senior design manager at <a href="https://www.jiva.ag" target="_blank" rel="noopener noreferrer">Jiva<span class="sr-only"> (opens in new tab)</span></a> (2022-2025), an Agritech startup, where I built and led the product design and research team, working on a suite of mobile apps and web apps for users in rural Indonesia. You can read about the work we did in our Medium publication, <a href="https://medium.com/notes-from-the-fields" target="_blank" rel="noopener noreferrer">Notes from the Fields<span class="sr-only"> (opens in new tab)</span></a>.
    </p>

    <p>
      As a product design leader, I have built remote-first, diverse teams across countries. I believe in building a culture where you can feel supported while being yourself. I believe in learning by doing, even in failure. And that good design isn't possible without a sponsor.
    </p>

    <p>
      In my spare time, I like to travel to new places, make <a href="https://www.instagram.com/filtercoffeeconnoisseur/" target="_blank" rel="noopener noreferrer">coffee content<span class="sr-only"> (opens in new tab)</span></a>, read <a href="https://www.goodreads.com/user/show/86283809-kenneth-dsouza" target="_blank" rel="noopener noreferrer">non-fiction and contemporary fiction<span class="sr-only"> (opens in new tab)</span></a>, collect graphic art, and write short stories and <a href="https://aninosaintlife.wordpress.com/category/travels/" target="_blank" rel="noopener noreferrer">travelogues<span class="sr-only"> (opens in new tab)</span></a>. I currently host <a href="https://designdemonights.com" target="_blank" rel="noopener noreferrer">designdemonights.com<span class="sr-only"> (opens in new tab)</span></a>, where designers can showcase the projects they are working on.
    </p>
    <p>
      Want to work with me or discuss a cool project that you are working on?
    </p>
    <p>
      Write me an email at kennethmdesouza [at] gmail [dot] com or DM me <a href="https://twitter.com/Kenneth" target="_blank" rel="noopener noreferrer">@kenneth<span class="sr-only"> (opens in new tab)</span></a>.
    </p>
  </section>

  <section class="resume-section">
    <h4>Leadership and Organizational Impact</h4>
    <ul class="resume-list">
      {leadershipHighlights.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </section>

  <section class="resume-section">
    <h4>Selected Writing and Speaking</h4>
    <ul class="resume-list">
      {selectedWritingAndSpeaking.map((item) => (
        <li>
          <a href={item.url} target="_blank" rel="noopener noreferrer">{item.title}<span class="sr-only"> (opens in new tab)</span></a>: {item.description}
        </li>
      ))}
    </ul>
  </section>

  <section class="resume-section">
    <h4>Work Experience</h4>

    <div class="experience-list">
      {experience.map((item) => (
        <article class="experience-item">
          <h3>{item.role}</h3>
          <p class="experience-meta">{item.company} • {item.period}</p>
          {item.photos && (
            <div class="workshop-photos">
              {item.photos.map((photo) => (
                <img src={photo.src} alt={photo.alt} width={photo.width ?? 1000} height={photo.height ?? 750} loading="lazy" />
              ))}
            </div>
          )}
          <ul class="resume-list">
            {item.details.map((detail) => (
              <li>{detail}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section class="resume-section">
    <h4>Workshops</h4>

    <div class="workshop-photos">
      <img src="/images/vizchitra-workshop-1.webp" alt="Group photo of workshop participants at VizChitra 2026" width="1000" height="667" loading="lazy" />
      <img src="/images/vizchitra-workshop-2.webp" alt="Kenneth presenting an introduction slide at the VizChitra 2026 workshop" width="1000" height="667" loading="lazy" />
    </div>

    <ul class="resume-list">
      {workshops.map((item) => (
        <li>
          <a href={item.url} target="_blank" rel="noopener noreferrer">{item.title}<span class="sr-only"> (opens in new tab)</span></a><span class="experience-meta"> ({item.date})</span>: {item.description}
        </li>
      ))}
    </ul>
  </section>

  <section class="resume-section">
    <h4>Education</h4>

    {education.map((item) => (
      <div class="education-item">
        <h3>{item.qualification}</h3>
        <p>{item.institution}</p>
        <p class="education-meta">{item.detail}</p>
        <p class="education-meta">{item.period}</p>
      </div>
    ))}
  </section>

  <section class="resume-section">
    <h4>Certifications</h4>

    {certifications.map((item) => (
      <div class="education-item">
        <h3>
          {item.url
            ? <a href={item.url} target="_blank" rel="noopener noreferrer">{item.title}<span class="sr-only"> (opens in new tab)</span></a>
            : item.title}
        </h3>
        <p>{item.institution}</p>
        <p class="education-meta">{item.year}</p>
      </div>
    ))}
  </section>

  <section class="resume-section">
    <h4>Elsewhere on the Internet</h4>
    <ul class="resume-list">
      {elsewhereOnTheInternet.map((item) => (
        <li>
          <a href={item.url} target="_blank" rel="noopener noreferrer">{item.title}<span class="sr-only"> (opens in new tab)</span></a>
          {item.year && <span class="experience-meta"> ({item.year})</span>}: {item.description}
        </li>
      ))}
    </ul>
  </section>

  <style>
    .workshop-photos {
      display: flex;
      flex-direction: row;
      flex-wrap: nowrap;
      gap: 1rem;
      margin-bottom: 1.5rem;
    }

    .workshop-photos img {
      flex: 1 1 0;
      min-width: 0;
      width: 0;
      height: 260px;
      border-radius: 8px;
      object-fit: cover;
    }

    @media (max-width: 640px) {
      .workshop-photos {
        flex-direction: column;
      }

      .workshop-photos img {
        width: 100%;
      }
    }

    .resume-intro {
      position: relative;
      margin-bottom: 3rem;
    }

    .resume-intro .profile-container {
      position: absolute;
      top: 0;
      right: 0;
    }

    .resume-header {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
      max-width: 800px;
      margin-bottom: 0;
    }

    .resume-header h1 {
      margin-bottom: 0;
    }

    .resume-download {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      text-decoration: none;
    }

    .resume-download__icon {
      font-size: 1rem;
      color: var(--color-primary);
    }

    .resume-section {
      margin-bottom: 3rem;
    }

    .resume-section h4 {
      margin-bottom: 1rem;
    }

    .resume-list {
      margin-bottom: 0;
      padding-left: 1.5rem;
    }

    .experience-list {
      display: grid;
      gap: 2rem;
    }

    .experience-item h3,
    .education-item h3 {
      color: var(--color-text);
      margin-bottom: 0.5rem;
    }

    .experience-meta,
    .education-meta {
      color: var(--color-text-secondary);
    }

    .experience-meta {
      margin-bottom: 0.75rem;
    }

    .education-item {
      margin-bottom: 1.5rem;
    }

    .education-item p {
      margin-bottom: 0;
    }
  </style>
</BaseLayout>
